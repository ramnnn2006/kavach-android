    <!-- Resident -->
    <string name="shared_intro_res_report_title">Report in seconds</string>
    <string name="shared_intro_res_report_text">Tap Report an emergency, choose what is happening and where, then hold the button for a second to send. Stuck in a lift? It is one tap.</string>
    <string name="shared_intro_res_track_title">Watch help arrive</string>
    <string name="shared_intro_res_track_text">See who accepted your alert, when they are on the way and when help has arrived. Call them straight from the screen.</string>
    <string name="shared_intro_res_offline_title">Works without signal</string>
    <string name="shared_intro_res_offline_text">No network? Your alert is saved on the phone and sent as soon as you are back online. The security desk number is always one tap away.</string>
    <string name="shared_intro_res_loop_title">Stay in the loop</string>
    <string name="shared_intro_res_loop_text">Answer Safety Checks, read society notices and get updates on your reports, even when the app is closed. Add health notes in Profile so responders know before they arrive.</string>
    <!-- Responder -->
    <string name="shared_intro_rsp_duty_title">Go on duty</string>
    <string name="shared_intro_rsp_duty_text">Switch On duty to get alerts for your work on this phone. When you are off duty, new alerts stay quiet.</string>
    <string name="shared_intro_rsp_claim_title">Claim an alert</string>
    <string name="shared_intro_rsp_claim_text">Open alerts are sorted by urgency. Tap Claim in the app or on the notification. If someone else was faster, you will see who took it.</string>
    <string name="shared_intro_rsp_steps_title">Keep everyone posted</string>
    <string name="shared_intro_rsp_steps_text">Tap On my way, I\'ve reached and Mark resolved. The resident sees each step live.</string>
    <string name="shared_intro_rsp_checks_title">Checks and equipment</string>
    <string name="shared_intro_rsp_checks_text">Log compliance checks and update the status of lifts, the DG and pumps from the Checks and Assets tabs.</string>
    <!-- Admin -->
    <string name="shared_intro_adm_overview_title">See everything</string>
    <string name="shared_intro_adm_overview_text">Overview shows what needs attention, unclaimed alerts and who is on duty, at a glance.</string>
    <string name="shared_intro_adm_step_in_title">Step in when needed</string>
    <string name="shared_intro_adm_step_in_text">Assign or reassign any alert. Alerts nobody claims are escalated to you after 2 and 5 minutes.</string>
    <string name="shared_intro_adm_manage_title">Run the society</string>
    <string name="shared_intro_adm_manage_text">Manage the team, the phone Members list, power mode, equipment, compliance, contacts and notices.</string>
    <string name="shared_intro_adm_crisis_title">In a crisis</string>
    <string name="shared_intro_adm_crisis_text">Start a Safety Check to ask a tower or the whole society \"Are you safe?\", and open the Command board on the security cabin\'s screen.</string>
