    <!-- Safety tips (one tip per item) -->
    <string-array name="resident_tips_lift">
        <item>Stay calm. Help has been alerted, and lifts have air vents — you will not run out of air.</item>
        <item>Press the alarm bell button inside the lift.</item>
        <item>Don\'t force the doors open or try to climb out.</item>
        <item>Stand away from the doors.</item>
        <item>Note the floor number on the display and tell the person who comes.</item>
    </string-array>
    <string-array name="resident_tips_fire">
        <item>Leave by the stairs. Never use the lift.</item>
        <item>Stay low if there is smoke — the air is cleaner near the floor.</item>
        <item>Close doors behind you to slow the fire.</item>
        <item>Don\'t go back in for belongings.</item>
        <item>Go to the assembly point and answer the Safety Check.</item>
    </string-array>
    <string-array name="resident_tips_medical">
        <item>Don\'t move the person if they might be injured.</item>
        <item>Keep them warm and comfortable.</item>
        <item>Keep their medicines and medical papers ready.</item>
        <item>If they are not breathing or not waking up, call 108 now.</item>
        <item>Keep your door open so help can find you.</item>
    </string-array>
    <string-array name="resident_tips_water">
        <item>Close the main water valve or the nearest tap if it is safe.</item>
        <item>Switch off power points near the water.</item>
        <item>Don\'t touch switches with wet hands.</item>
        <item>Move your things away from the water.</item>
    </string-array>
    <string-array name="resident_tips_power">
        <item>Stay away from sparking wires or switchboards.</item>
        <item>Switch off the main switch (MCB) only if it is safe.</item>
        <item>Don\'t use the lift during a power cut.</item>
        <item>Unplug costly appliances.</item>
    </string-array>
    <string-array name="resident_tips_security">
        <item>Stay inside and lock your door.</item>
        <item>Don\'t confront the person.</item>
        <item>Note what they look like and which way they went.</item>
        <item>If anyone is in danger, call 112.</item>
    </string-array>
